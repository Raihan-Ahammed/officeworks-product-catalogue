# Copy to .env (optional - the defaults below work out of the box).

# Port the backend listens on. The web dev server proxies /api here.
PORT=4000

# Product data source. Swappable: any service returning the same product shape works.
FAKE_STORE_API_BASE=https://fakestoreapi.com

# How long the backend caches the product list before re-fetching upstream.
CACHE_TTL_MS=300000

# Where enquiry emails are delivered.
SALES_INBOX=sales@example.com

# Email delivery. Default smtp points at the local Maildev inbox that
# `npm run dev` starts (web UI on http://localhost:1080, no account needed).
# For production, point these at a real provider (SES, SendGrid, ...).
# EMAIL_PROVIDER=console logs the email to the backend console instead.
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=catalogue@localhost
